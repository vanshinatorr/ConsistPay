VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY=your_razorpay_key_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Nexconn Web Chat SDK Configuration
# Public App Key provided by Nexconn Console (safe for client side)
VITE_NEXCONN_APP_KEY=your_nexconn_app_key
# Optional developer test user token (in production, tokens are generated by backend using App Secret)
VITE_NEXCONN_USER_TOKEN=your_nexconn_user_token
